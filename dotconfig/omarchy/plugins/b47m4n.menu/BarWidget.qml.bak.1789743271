import QtQuick
import QtQuick.Effects
import qs.Commons
import qs.Ui

BarWidget {
  id: root
  moduleName: "b47m4n.menu"

  readonly property real iconHeight: Math.max(10, Math.round(Style.font.body * 1.05))
  readonly property real iconWidth: Math.round(iconHeight * (175.75 / 59.6211))

  implicitWidth: button.implicitWidth
  implicitHeight: button.implicitHeight

  WidgetButton {
    id: button
    anchors.fill: parent
    bar: root.bar
    labelVisible: false
    hasVisualContent: true
    horizontalMargin: 8
    fixedWidth: vertical ? -1 : Math.round(root.iconWidth + scaledHorizontalMargin * 2)
    fixedHeight: vertical ? Math.round(root.iconHeight + scaledVerticalPadding * 2) : -1

    Item {
      id: iconContainer
      anchors.centerIn: parent
      width: root.iconWidth
      height: root.iconHeight

      Image {
        id: logoImage
        anchors.fill: parent
        source: Qt.resolvedUrl("assets/batman-seeklogo.svg")
        fillMode: Image.PreserveAspectFit
        sourceSize.width: Math.round(root.iconWidth * Screen.devicePixelRatio * 2)
        sourceSize.height: Math.round(root.iconHeight * Screen.devicePixelRatio * 2)
        smooth: true
        mipmap: true
        visible: false
      }

      property real pulseFactor: 0.35
      readonly property bool isFlaring: button.tooltipHovered || button.active
      property real shimmerPhase: 0.0

      SequentialAnimation on pulseFactor {
        id: pulseAnim
        running: true
        loops: Animation.Infinite

        NumberAnimation {
          from: 0.25
          to: 1.0
          duration: 1600
          easing.type: Easing.InOutSine
        }
        NumberAnimation {
          from: 1.0
          to: 0.25
          duration: 1600
          easing.type: Easing.InOutSine
        }
      }

      SequentialAnimation on shimmerPhase {
        id: shimmerAnim
        running: true
        loops: Animation.Infinite

        NumberAnimation {
          from: 0.0
          to: 1.0
          duration: iconContainer.isFlaring ? 650 : 950
          easing.type: Easing.InOutQuad
        }
        PauseAnimation {
          duration: iconContainer.isFlaring ? 150 : 2600
        }
      }

      onIsFlaringChanged: {
        shimmerAnim.stop()
        shimmerPhase = 0.0
        shimmerAnim.start()
      }

      readonly property color glowColor: button.active && button.useActiveColor ? button.activeColor : Qt.lighter(Color.accent, 1.15)

      // Container for all glow passes - controls breathing pulse & hover stay-lit
      Item {
        id: glowContainer
        anchors.fill: parent
        opacity: (button.tooltipHovered || button.active) ? 1.0 : iconContainer.pulseFactor

        Behavior on opacity {
          enabled: button.tooltipHovered || button.active
          NumberAnimation { duration: 250; easing.type: Easing.OutCubic }
        }

        // Outer neon bloom (Tightened radius)
        Item {
          anchors.centerIn: parent
          width: Math.round(root.iconWidth * 1.30)
          height: Math.round(root.iconHeight * 1.30)

          Image {
            id: glowImgOuter
            anchors.fill: parent
            source: logoImage.source
            fillMode: Image.PreserveAspectFit
            sourceSize.width: Math.round(parent.width * Screen.devicePixelRatio * 2)
            sourceSize.height: Math.round(parent.height * Screen.devicePixelRatio * 2)
            smooth: true
            mipmap: true
            visible: false
          }

          MultiEffect {
            anchors.fill: parent
            source: glowImgOuter
            colorization: 1.0
            colorizationColor: iconContainer.glowColor
            blurEnabled: true
            blur: 0.8
            blurMax: 20
            blurMultiplier: 1.2
            opacity: 0.65

            Behavior on colorizationColor {
              enabled: !button.bar || button.bar.foregroundAnimationEnabled
              ColorAnimation { duration: 160 }
            }
          }
        }

        // Mid radiant neon glow (Tightened radius)
        Item {
          anchors.centerIn: parent
          width: Math.round(root.iconWidth * 1.18)
          height: Math.round(root.iconHeight * 1.18)

          Image {
            id: glowImgMid
            anchors.fill: parent
            source: logoImage.source
            fillMode: Image.PreserveAspectFit
            sourceSize.width: Math.round(parent.width * Screen.devicePixelRatio * 2)
            sourceSize.height: Math.round(parent.height * Screen.devicePixelRatio * 2)
            smooth: true
            mipmap: true
            visible: false
          }

          MultiEffect {
            anchors.fill: parent
            source: glowImgMid
            colorization: 1.0
            colorizationColor: iconContainer.glowColor
            blurEnabled: true
            blur: 0.5
            blurMax: 16
            blurMultiplier: 0.9
            opacity: 0.8

            Behavior on colorizationColor {
              enabled: !button.bar || button.bar.foregroundAnimationEnabled
              ColorAnimation { duration: 160 }
            }
          }
        }

        // Tight edge halo (Contoured)
        Item {
          anchors.centerIn: parent
          width: Math.round(root.iconWidth * 1.08)
          height: Math.round(root.iconHeight * 1.08)

          Image {
            id: glowImgInner
            anchors.fill: parent
            source: logoImage.source
            fillMode: Image.PreserveAspectFit
            sourceSize.width: Math.round(parent.width * Screen.devicePixelRatio * 2)
            sourceSize.height: Math.round(parent.height * Screen.devicePixelRatio * 2)
            smooth: true
            mipmap: true
            visible: false
          }

          MultiEffect {
            anchors.fill: parent
            source: glowImgInner
            colorization: 1.0
            colorizationColor: iconContainer.glowColor
            blurEnabled: true
            blur: 0.25
            blurMax: 10
            blurMultiplier: 0.6
            opacity: 0.9

            Behavior on colorizationColor {
              enabled: !button.bar || button.bar.foregroundAnimationEnabled
              ColorAnimation { duration: 160 }
            }
          }
        }
      }

      // Crisp Foreground Core Logo
      MultiEffect {
        anchors.fill: logoImage
        source: logoImage
        colorization: 1.0
        colorizationColor: button.active && button.useActiveColor ? button.activeColor : button.foreground

        Behavior on colorizationColor {
          enabled: !button.bar || button.bar.foregroundAnimationEnabled
          ColorAnimation { duration: 160 }
        }
      }

      // Holographic Armor Shimmer Glint (Masked to Bat Wings)
      Item {
        id: shimmerLayer
        anchors.fill: logoImage
        layer.enabled: true
        layer.smooth: true
        layer.effect: MultiEffect {
          autoPaddingEnabled: false
          maskEnabled: true
          maskSource: logoImage
          maskThresholdMin: 0.5
          maskSpreadAtMin: 1.0
        }

        Rectangle {
          id: shimmerGlint
          width: Math.round(parent.width * 0.45)
          height: Math.round(parent.height * 2.5)
          anchors.verticalCenter: parent.verticalCenter
          rotation: 25
          x: -width + iconContainer.shimmerPhase * (parent.width + width * 2)

          gradient: Gradient {
            orientation: Gradient.Horizontal
            GradientStop { position: 0.0; color: "transparent" }
            GradientStop { position: 0.35; color: Util.alpha("#ffffff", iconContainer.isFlaring ? 0.95 : 0.75) }
            GradientStop { position: 0.65; color: Util.alpha(iconContainer.glowColor, iconContainer.isFlaring ? 0.95 : 0.8) }
            GradientStop { position: 1.0; color: "transparent" }
          }

          opacity: iconContainer.isFlaring ? 1.0 : 0.85
        }
      }
    }

    onPressed: function(btn) {
      if (!root.bar) return
      if (btn === Qt.RightButton) root.bar.run("xdg-terminal-exec")
      else root.bar.run("omarchy-shell shell toggle b47m4n.menu '{\"menu\":\"root\"}'")
    }
  }
}
